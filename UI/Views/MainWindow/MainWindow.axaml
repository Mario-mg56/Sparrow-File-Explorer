<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:components="clr-namespace:DynamicFileExplorer.UI.Components"
        xmlns:vm="clr-namespace:DynamicFileExplorer.ViewModels"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="DynamicFileExplorer.UI.Views.MainWindow.MainWindow"
        Title="DynamicFileExplorer">
    <Grid  ColumnDefinitions="1*, 4*, 1*" Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="9*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="Green" Name="HeaderContainer">
                <components:HeaderContainer />
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Background="Red"  Name="HierarchyContainer">
                <components:HierarchyView/>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Background="Blue">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <components:FilesGrid/>
            </ScrollViewer>
        </Border>
        <Border Grid.Row="1" Grid.Column="2" Background="Red"  Name="InspectorContainer">
            <TextBlock Text="RightSidebar"/>
        </Border>
        <Canvas
            Name="Overlay"
            Grid.RowSpan="2"
            Grid.ColumnSpan="3"
        />
    </Grid>
</Window>