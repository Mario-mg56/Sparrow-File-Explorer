<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="DynamicFileExplorer.UI.Views.MainWindow.MainWindow"
        Title="DynamicFileExplorer">
    <Grid RowDefinitions="1*, 9*" ColumnDefinitions="1*, 4*, 1*">
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="Green">
            <TextBlock Text="Header"/>
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Background="Red">
            <TextBlock Text="LeftSidebar"/>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Background="Blue">
            <Grid Name="FilesGrid"/>
        </Border>
        <Border Grid.Row="1" Grid.Column="2" Background="Red">
            <TextBlock Text="RightSidebar"/>
        </Border>
    </Grid>

</Window>