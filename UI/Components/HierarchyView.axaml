<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DynamicFileExplorer.ViewModels"
             xmlns:components="clr-namespace:DynamicFileExplorer.UI.Components"
             x:Class="DynamicFileExplorer.UI.Components.HierarchyView"
             x:DataType="vm:HierarchyViewModel">

    <TreeView ItemsSource="{Binding Roots}">

    <TreeView.Styles>
        <Style Selector="TreeViewItem /template/ ToggleButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </TreeView.Styles>

    <TreeView.ItemTemplate>
        <TreeDataTemplate DataType="vm:FolderNodeViewModel"
                          ItemsSource="{Binding Children}">
            <components:FolderNodeView/>
        </TreeDataTemplate>
    </TreeView.ItemTemplate>

</TreeView>


</UserControl>
