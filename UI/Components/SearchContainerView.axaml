<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DynamicFileExplorer.ViewModels"
             xmlns:components="clr-namespace:DynamicFileExplorer.UI.Components"
             x:Class="DynamicFileExplorer.UI.Components.SearchContainerView"
             x:DataType="vm:SearchContainerViewModel">

    <Border Padding="8" Background="#1e1e1e" CornerRadius="6">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

            <!-- Input -->
            <TextBox
                Grid.Column="0"
                Text="{Binding SearchText, Mode=TwoWay}"
                Watermark="Buscar archivos..."
                VerticalAlignment="Center"/>

            <!-- Botón Buscar -->
            <Button
                Grid.Column="1"
                Content="{Binding BuscarText}"
                Command="{Binding SearchCommand}"
                VerticalAlignment="Center"/>
                
        </Grid>
    </Border>


</UserControl>
