<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:DynamicFileExplorer.UI.Components"
    x:Class="DynamicFileExplorer.UI.Components.TabView"
>
    <UserControl.Styles>
        <Style Selector="Border#TabBorder">
            <Setter Property="Background" Value="{DynamicResource TabBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TabBorder}" />
        </Style>

        <Style Selector="Border#TabBorder:pointerover">
            <Setter Property="Background" Value="{DynamicResource TabHover}" /> 
        </Style>
    </UserControl.Styles>
    <Border
        Padding="12,6" 
        BorderThickness="0,1,1,1"
        Name="TabBorder"
        Height="36"
    >
        <StackPanel Orientation="Horizontal">
            <TextBlock
                Text="{Binding Title, RelativeSource={RelativeSource AncestorType=components:TabView}}"
                VerticalAlignment="Center"
                MinWidth="32"
                Margin="0,0,8,0"
            />
            <components:SVGIcon
                Name="CloseButton"
                IconPath="{Binding CloseIconPath, RelativeSource={RelativeSource AncestorType=components:TabView}}"
                IconSize="12"
                Padding_x="10"
                Padding_y="10"
                Width="24"
                Height="24"
                CornerRadius="50"
                IconForeground="White"
                HoverBackground="{DynamicResource IconHover}"
                HoverForeground="White"
                VerticalAlignment="Center"
            />    
        </StackPanel>
    </Border>
</UserControl>