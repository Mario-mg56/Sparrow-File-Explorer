<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DynamicFileExplorer.UI.Components.ThemesSettingsView">
    <Grid RowDefinitions="Auto, *" ColumnDefinitions="250, 20, *" Height="500">
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Theme Management" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="*, Auto" RowSpacing="10">
            <ListBox Name="ThemesList" Grid.Row="0" Background="{DynamicResource SecondaryTransparent}" CornerRadius="8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="✕" Background="Transparent" Foreground="{DynamicResource Destructive}" Padding="5,2" Name="DeleteThemeBtn" Click="OnDeleteThemeClick"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            
            <Button Grid.Row="1" Content="+ Add Custom Theme" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Name="AddThemeBtn"/>
        </Grid>

        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource SecondaryTransparent}" CornerRadius="8" Padding="20">
            <ContentControl Name="ThemeEditorContainer">
                <TextBlock Text="Select a theme from the list to edit its colors." VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
            </ContentControl>
        </Border>
    </Grid>
</UserControl>