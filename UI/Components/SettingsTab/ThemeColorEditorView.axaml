<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DynamicFileExplorer.UI.Components.ThemeColorEditorView">
    <ScrollViewer>
        <StackPanel Spacing="12" Margin="20,10">
            <TextBlock Text="Theme Configuration" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
            
            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,15,0">
                    <TextBlock Text="Theme Name" FontSize="12" Foreground="Gray"/>
                    <TextBox Name="ThemeNameTextBox" Watermark="Enter unique theme name..."/>
                </StackPanel>
                <Button Name="ActivateThemeBtn" Grid.Column="1" Content="Activate Theme" 
                        VerticalAlignment="Bottom" Padding="15,8" Background="{DynamicResource SecondaryTransparent}" Foreground="{DynamicResource Foreground}"/>
            </Grid>
            
            <Border Height="1" Background="#20000000" Margin="0,5,0,10"/>
            
            <TextBlock Text="Edit Colors" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <StackPanel Name="ColorsContainer" Spacing="12">
                </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>