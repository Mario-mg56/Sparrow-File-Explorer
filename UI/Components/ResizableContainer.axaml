<Style xmlns="https://github.com/avaloniaui"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:vm="clr-namespace:DynamicFileExplorer.ViewModels"
        xmlns:local="clr-namespace:DynamicFileExplorer.UI.Components"
       >

        <ControlTemplate>

            <Border Background="Green">

                <Grid RowDefinitions="*, 5">

                    <!-- 🔥 CONTENIDO INYECTADO -->
                    <ContentPresenter Content="{Binding Content}"
                                      Grid.Row="0"/>

                    <!-- 🔥 ZONA RESIZE -->
                    <Border Grid.Row="1"
                            Background="DarkGray"
                            Cursor="SizeNorthSouth"/>
                </Grid>

            </Border>

        </ControlTemplate>

</Style>
